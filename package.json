{
  "name": "voxgen-ai-podcast-studio",
  "version": "1.0.0",
  "description": "VoxGen - AI Podcast Studio: Create stunning podcasts with the power of AI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "node server.js",
